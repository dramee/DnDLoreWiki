      "seed": 2013043617,
      "version": 534,
      "versionNonce": 1454828623,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791639500162,
      "created": 1791636474214,
      "link": null,
      "locked": false,
      "text": "- прибытие человеков на континнет\n-расселение людей по западной части континента\n- первые государства людей на конкретно этом континенте\n- контакт человеков с другими расами\n- зарождение империи порядка\n- \"официальный\" контакт человеческой цивилизации с\nдругими цивилизации\n- ",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "kJFAkzBRQZrFX_hCTHb85",
      "originalText": "- прибытие человеков на континнет\n-расселение людей по западной части континента\n- первые государства людей на конкретно этом континенте\n- контакт человеков с другими расами\n- зарождение империи порядка\n- \"официальный\" контакт человеческой цивилизации с другими цивилизации\n- ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
